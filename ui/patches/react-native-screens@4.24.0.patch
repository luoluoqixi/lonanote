+
+static BOOL RNSHeaderContainsVisualEffectView(UIView *view)
+{
+  if ([view isKindOfClass:[UIVisualEffectView class]]) {
+    return YES;
+  }
+  for (UIView *subview in view.subviews) {
+    if (RNSHeaderContainsVisualEffectView(subview)) {
+      return YES;
+    }
+  }
+  return NO;
+}
+
+static UIView *RNSHeaderFindBarBackground(UINavigationBar *navigationBar)
+{
+  CGFloat navigationBarWidth = CGRectGetWidth(navigationBar.bounds);
+  for (UIView *subview in navigationBar.subviews) {
+    BOOL spansNavigationBar = CGRectGetWidth(subview.bounds) >= navigationBarWidth - 1.0;
+    BOOL startsAtOrAboveNavigationBar = CGRectGetMinY(subview.frame) <= 0.5;
+    if (spansNavigationBar && startsAtOrAboveNavigationBar && RNSHeaderContainsVisualEffectView(subview)) {
+      return subview;
+    }
+  }
+  return nil;
+}
+
+static void RNSHeaderAnimateEffectPosition(UIView *view, CFTimeInterval duration)
+{
+  CALayer *layer = view.layer;
+  CALayer *presentation = (CALayer *)layer.presentationLayer;
+  if (presentation == nil) {
+    return;
+  }
+
+  CABasicAnimation *positionAnimation = [CABasicAnimation animationWithKeyPath:@"position"];
+  positionAnimation.fromValue = [NSValue valueWithCGPoint:presentation.position];
+  positionAnimation.toValue = [NSValue valueWithCGPoint:layer.position];
+  positionAnimation.duration = MAX(duration, 0.01);
+  positionAnimation.fillMode = kCAFillModeForwards;
+  positionAnimation.removedOnCompletion = NO;
+  [layer addAnimation:positionAnimation forKey:RNSHeaderCancelledTransitionEffectPositionAnimationKey];
+}
+
+static void RNSHeaderAnimateEffectViewTreePositions(UIView *view, CFTimeInterval duration)
+{
+  RNSHeaderAnimateEffectPosition(view, duration);
+  for (UIView *subview in view.subviews) {
+    RNSHeaderAnimateEffectViewTreePositions(subview, duration);
+  }
+}
+
+static void RNSHeaderAnimateVisualEffectPositions(UIView *background, CFTimeInterval duration)
+{
+  for (UIView *subview in background.subviews) {
+    if ([subview isKindOfClass:[UIVisualEffectView class]]) {
+      RNSHeaderAnimateEffectViewTreePositions(subview, duration);
+    }
+  }
+}
+
+static void RNSHeaderRemoveEffectViewTreePositionAnimations(UIView *view)
+{
+  [view.layer removeAnimationForKey:RNSHeaderCancelledTransitionEffectPositionAnimationKey];
+  for (UIView *subview in view.subviews) {
+    RNSHeaderRemoveEffectViewTreePositionAnimations(subview);
+  }
+}
+
+static void RNSHeaderRemoveVisualEffectPositionAnimations(UIView *background)
+{
+  for (UIView *subview in background.subviews) {
+    if ([subview isKindOfClass:[UIVisualEffectView class]]) {
+      RNSHeaderRemoveEffectViewTreePositionAnimations(subview);
+    }
+  }
+}
+
+static void RNSHeaderClearGeometryFixState(UINavigationBar *navigationBar)
+{
+  RNSHeaderCancelledTransitionFixState *state =
+      objc_getAssociatedObject(navigationBar, &RNSHeaderCancelledTransitionFixStateKey);
+  if (state.background != nil) {
+    RNSHeaderRemoveVisualEffectPositionAnimations(state.background);
+  }
+  objc_setAssociatedObject(
+      navigationBar, &RNSHeaderCancelledTransitionFixStateKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
 
