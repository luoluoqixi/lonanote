+  init {
+    mGestureDetector = GestureDetector(mContext, object : GestureDetector.SimpleOnGestureListener() {
+      override fun onLongPress(e: MotionEvent) {
+        if (!mIsOnLongPress) {
+          return
+        }
+        prepareMenu()
+      }
+
+      override fun onSingleTapUp(e: MotionEvent): Boolean {
+        if (!mIsOnLongPress) {
+          prepareMenu()
+        }
+        return true
+      }
+    })
+  }
