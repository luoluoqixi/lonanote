+      }
+      // Custom row backgrounds and reliable center alignment require AppCompat's popup ListView.
+      // Start/end ordinary menus can retain the framework PopupMenu presentation.
+      if (mSelectedItemBackgroundColor == null && mAnchorAlignment != "center") {
+        prepareFrameworkMenu()
+        return
+      }
+      mIsUsingFrameworkPopupMenu = false
+      mPopupMenu.menu.clear()
+      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+        mPopupMenu.gravity = when {
+          mAnchorAlignment == "end" || mIsAnchoredToRight -> Gravity.RIGHT
+          mAnchorAlignment == "center" -> Gravity.CENTER_HORIZONTAL
+          else -> Gravity.LEFT
+        }
+      }
+      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+        mPopupMenu.setForceShowIcon(true)
+      }
+      var i = 0
+      while (i < getActionsCount) {
+        if (!mActions.isNull(i)) {
+          val item = mActions.getMap(i)
+          val menuItem = when (item != null && item.hasKey("subactions") && !item.isNull("subactions")) {
+            true -> mPopupMenu.menu.addSubMenu(Menu.NONE, Menu.NONE, i, item.getString("title")).item
+            else -> mPopupMenu.menu.add(Menu.NONE, Menu.NONE, i, item?.getString("title"))
+          }
+          prepareMenuItem(menuItem, item)
+          menuItem.setOnMenuItemClickListener {
+            if (!it.hasSubMenu()) {
+              mIsMenuDisplayed = false
+              if (!mActions.isNull(it.order)) {
+                val selectedItem = mActions.getMap(it.order)
+                val dispatcher =
+                  UIManagerHelper.getEventDispatcherForReactTag(mContext, id)
+                val surfaceId: Int = UIManagerHelper.getSurfaceId(this)
+                dispatcher?.dispatchEvent(
+                  MenuOnPressActionEvent(surfaceId, id, selectedItem?.getString("id"), id)
+                )
+              }
+              true
+            } else {
+              // Change the title only after the submenu trigger is clicked: AppCompat copies this
+              // CharSequence into its header, while the trigger row keeps its ordinary item color.
+              resolveFrameworkPopupMenuHeaderColor()?.let { color ->
+                it.title = getMenuItemTextWithColor(it.title.toString(), color)
+              }
+              false
+            }
+          }
+        }
+        i++
+      }
+      mPopupMenu.setOnDismissListener {
+        mIsMenuDisplayed = false
+        detachPopupScrollObserver()
+        val dispatcher = UIManagerHelper.getEventDispatcherForReactTag(mContext, id)
+        val surfaceId: Int = UIManagerHelper.getSurfaceId(this)
+        dispatcher?.dispatchEvent(MenuOnCloseEvent(surfaceId, id, id))
+      }
+      mIsMenuDisplayed = true
+      val dispatcher = UIManagerHelper.getEventDispatcherForReactTag(mContext, id)
+      val surfaceId: Int = UIManagerHelper.getSurfaceId(this)
+      dispatcher?.dispatchEvent(MenuOnOpenEvent(surfaceId, id, id))
+      mPopupMenu.show()
+      applyPopupPresentation()
+    }
+  }
+
+  private fun prepareFrameworkMenu() {
+    mIsUsingFrameworkPopupMenu = true
+    mFrameworkPopupMenu.menu.clear()
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+      mFrameworkPopupMenu.gravity = when (mIsAnchoredToRight) {
+        true -> Gravity.RIGHT
+        false -> Gravity.LEFT
+      }
+    }
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+      mFrameworkPopupMenu.setForceShowIcon(true)
+    }
+    var i = 0
+    while (i < getActionsCount) {
+      if (!mActions.isNull(i)) {
+        val item = mActions.getMap(i)
+        val menuItem = when (item != null && item.hasKey("subactions") && !item.isNull("subactions")) {
+          true -> mFrameworkPopupMenu.menu.addSubMenu(Menu.NONE, Menu.NONE, i, item.getString("title")).item
+          else -> mFrameworkPopupMenu.menu.add(Menu.NONE, Menu.NONE, i, item?.getString("title"))
+        }
+        prepareMenuItem(menuItem, item)
+        menuItem.setOnMenuItemClickListener {
+          if (!it.hasSubMenu()) {
+            mIsMenuDisplayed = false
+            if (!mActions.isNull(it.order)) {
+              val selectedItem = mActions.getMap(it.order)
+              val dispatcher = UIManagerHelper.getEventDispatcherForReactTag(mContext, id)
+              val surfaceId: Int = UIManagerHelper.getSurfaceId(this)
+              dispatcher?.dispatchEvent(
+                MenuOnPressActionEvent(surfaceId, id, selectedItem?.getString("id"), id)
+              )
+            }
+            true
+          } else {
+            false
+          }
+        }
+      }
+      i++
+    }
+    mFrameworkPopupMenu.setOnDismissListener {
+      mIsMenuDisplayed = false
+      val dispatcher = UIManagerHelper.getEventDispatcherForReactTag(mContext, id)
+      val surfaceId: Int = UIManagerHelper.getSurfaceId(this)
+      dispatcher?.dispatchEvent(MenuOnCloseEvent(surfaceId, id, id))
+    }
+    mIsMenuDisplayed = true
+    val dispatcher = UIManagerHelper.getEventDispatcherForReactTag(mContext, id)
+    val surfaceId: Int = UIManagerHelper.getSurfaceId(this)
+    dispatcher?.dispatchEvent(MenuOnOpenEvent(surfaceId, id, id))
+    mFrameworkPopupMenu.show()
+  }
+
+  private data class PopupPresentation(
+    val popupWindow: Any,
+    val listView: ListView,
+  )
+
+  private fun findField(target: Any, fieldName: String): Field? {
+    var currentClass: Class<*>? = target.javaClass
+    while (currentClass != null) {
+      try {
+        return currentClass.getDeclaredField(fieldName).apply { isAccessible = true }
+      } catch (_: NoSuchFieldException) {
+        currentClass = currentClass.superclass
+      }
+    }
+    return null
+  }
+
+  private fun findMethod(target: Any, methodName: String, parameterCount: Int): java.lang.reflect.Method? {
+    var currentClass: Class<*>? = target.javaClass
+    while (currentClass != null) {
+      val method = currentClass.declaredMethods.firstOrNull {
+        it.name == methodName && it.parameterTypes.size == parameterCount
+      }
+      if (method != null) {
+        method.isAccessible = true
+        return method
+      }
+      currentClass = currentClass.superclass
+    }
+    return null
+  }
+
+  private fun resolvePopupPresentation(): PopupPresentation? {
+    val popupHelper = findField(mPopupMenu, "mPopup")?.get(mPopupMenu) ?: return null
+    val popup = findMethod(popupHelper, "getPopup", 0)?.invoke(popupHelper) ?: return null
+    // StandardMenuPopup.show() 在已显示时直接返回；真正能 update 的是其内部 MenuPopupWindow。
+    val popupWindow = findField(popup, "mPopup")?.get(popup) ?: popup
+    val listView = findMethod(popupWindow, "getListView", 0)?.invoke(popupWindow) as? ListView
+      ?: findMethod(popup, "getListView", 0)?.invoke(popup) as? ListView
+      ?: return null
+    return PopupPresentation(popupWindow, listView)
+  }
+
+  private fun applyPopupAlignment(presentation: PopupPresentation) {
+    if (!mIsMenuDisplayed || mAnchorAlignment != "center") {
+      return
+    }
+    val popupIsShowing = findMethod(presentation.popupWindow, "isShowing", 0)
+      ?.invoke(presentation.popupWindow) as? Boolean ?: false
+    if (!popupIsShowing) {
+      return
+    }
+
+    val listView = presentation.listView
+    if (listView.childCount == 0) {
+      return
+    }
+    val anchorWidth = width.takeIf { it > 0 }
+      ?: measuredWidth.takeIf { it > 0 }
+      ?: return
+    val popupWidth = listView.width.takeIf { it > 0 }
+      ?: listView.measuredWidth.takeIf { it > 0 }
+      ?: return
+    val horizontalOffset = (anchorWidth - popupWidth) / 2
+    val setHorizontalOffset = findMethod(presentation.popupWindow, "setHorizontalOffset", 1)
+      ?: return
+    setHorizontalOffset.invoke(presentation.popupWindow, horizontalOffset)
+    // 仅更新仍在显示的 ListPopupWindow；关闭后的延迟任务不能再次 show。
+    if (mIsMenuDisplayed) {
+      findMethod(presentation.popupWindow, "show", 0)?.invoke(presentation.popupWindow)
+    }
+  }
+
+  private fun schedulePopupAlignment(presentation: PopupPresentation) {
+    if (!mIsMenuDisplayed || mAnchorAlignment != "center" || mPopupLayoutListenerAttached) {
+      return
+    }
+
+    val listView = presentation.listView
+    mPopupLayoutListenerAttached = true
+    listView.viewTreeObserver.addOnGlobalLayoutListener(object : ViewTreeObserver.OnGlobalLayoutListener {
+      override fun onGlobalLayout() {
+        if (listView.viewTreeObserver.isAlive) {
+          listView.viewTreeObserver.removeOnGlobalLayoutListener(this)
+        }
+        mPopupLayoutListenerAttached = false
+        if (!mIsMenuDisplayed) {
+          return
+        }
+        applyPopupAlignment(presentation)
+        listView.post { applySelectedItemBackground(listView) }
+      }
+    })
+  }
+
+  private fun applySelectedItemBackground(listView: ListView) {
+    if (!mIsMenuDisplayed) {
+      return
+    }
+    val selectedBackgroundColor = mSelectedItemBackgroundColor ?: return
+    for (childIndex in 0 until listView.childCount) {
+      val row = listView.getChildAt(childIndex)
+      if (!mOriginalItemBackgrounds.containsKey(row)) {
+        mOriginalItemBackgrounds[row] = row.background
+        mOriginalItemBackgroundTints[row] = row.backgroundTintList
+      }
+      val actionOrder = listView.firstVisiblePosition + childIndex
+      if (mSelectedActionOrders.contains(actionOrder)) {
+        // 系统 Menu 行自带的灰色 tint 会覆盖 ColorDrawable，选中时必须清除。
+        row.backgroundTintList = null
+        row.background = ColorDrawable(selectedBackgroundColor)
+      } else {
+        // ListView 会复用行视图，未选中行必须恢复原 selector，避免背景跟着视图滚动。
+        row.background = mOriginalItemBackgrounds[row]
+        row.backgroundTintList = mOriginalItemBackgroundTints[row]
+      }
+    }
+  }
+
+  private fun scrollSelectedItemIntoView(listView: ListView) {
+    if (mSelectedItemScrollApplied || listView.height <= 0 || listView.childCount == 0) {
+      return
+    }
+    val selectedPosition = mSelectedActionOrders.firstOrNull() ?: run {
+      mSelectedItemScrollApplied = true
+      return
+    }
+    val rowHeight = listView.getChildAt(0)?.height ?: 0
+    val centeredTop = ((listView.height - rowHeight) / 2).coerceAtLeast(0)
+    listView.setSelectionFromTop(selectedPosition, centeredTop)
+    mSelectedItemScrollApplied = true
+  }
+
+  private fun detachPopupScrollObserver() {
+    val listView = mObservedListView
+    val listener = mPopupScrollChangedListener
+    if (listView != null && listener != null && listView.viewTreeObserver.isAlive) {
+      listView.viewTreeObserver.removeOnScrollChangedListener(listener)
+    }
+    mObservedListView = null
+    mPopupScrollChangedListener = null
+  }
+
+  private fun observePopupListScrolling(listView: ListView) {
+    if (mObservedListView === listView && mPopupScrollChangedListener != null) {
+      return
+    }
+    detachPopupScrollObserver()
+    val listener = ViewTreeObserver.OnScrollChangedListener {
+      if (mIsMenuDisplayed) {
+        listView.post {
+          applySelectedItemBackground(listView)
+        }
+      }
+    }
+    listView.viewTreeObserver.addOnScrollChangedListener(listener)
+    mObservedListView = listView
+    mPopupScrollChangedListener = listener
+  }
+
+  /** PopupMenu 布局是异步的，多次尝试可覆盖不同 Android/厂商的渲染时机。 */
+  private fun applyPopupPresentation() {
+    mSelectedActionOrders.clear()
+    mPopupLayoutListenerAttached = false
+    mSelectedItemScrollApplied = false
+    if (mSelectedItemBackgroundColor != null) {
+      for (index in 0 until mPopupMenu.menu.size()) {
+        val menuItem = mPopupMenu.menu.getItem(index)
+        if (menuItem.isChecked) {
+          mSelectedActionOrders.add(menuItem.order)
+        }
+        menuItem.isCheckable = false
+        menuItem.isChecked = false
+      }
+    }
+    longArrayOf(0L, 16L, 48L, 96L, 160L, 240L).forEach { delay ->
+      postDelayed({
+        // 点击项目或点外部关闭后，剩余延迟任务必须全部失效。
+        if (!mIsMenuDisplayed) {
+          return@postDelayed
+        }
+        try {
+          val presentation = resolvePopupPresentation() ?: return@postDelayed
+          observePopupListScrolling(presentation.listView)
+          schedulePopupAlignment(presentation)
+          presentation.listView.post {
+            if (!mIsMenuDisplayed) {
+              return@post
+            }
+            applyPopupAlignment(presentation)
+            presentation.listView.post {
+              scrollSelectedItemIntoView(presentation.listView)
+              presentation.listView.post {
+                applySelectedItemBackground(presentation.listView)
+              }
+            }
+          }
+        } catch (_: Exception) {
+          // ROM 不开放 PopupMenu 内部视图时，不影响菜单基本打开行为。
+        }
+      }, delay)
+    }
+  }
+
+  private class MenuItemLineBackgroundSpan(
+    private val backgroundColor: Int,
+  ) : LineBackgroundSpan {
+    override fun drawBackground(
+      canvas: Canvas,
+      paint: Paint,
+      left: Int,
+      right: Int,
+      top: Int,
+      baseline: Int,
+      bottom: Int,
+      text: CharSequence,
+      start: Int,
+      end: Int,
+      lineNumber: Int,
+    ) {
+      val originalColor = paint.color
+      paint.color = backgroundColor
+      canvas.drawRect(left.toFloat(), top.toFloat(), right.toFloat(), bottom.toFloat(), paint)
+      paint.color = originalColor
+    }
+  }
+
+  private fun updateTouchDelegate() {
+    post {
+      val hitRect = Rect()
+      getHitRect(hitRect)
+
+      mHitSlopRect?.let {
+        hitRect.left -= it.left
+        hitRect.top -= it.top
+        hitRect.right += it.right
+        hitRect.bottom += it.bottom
+      }
+
+      (parent as? ViewGroup)?.let {
+        it.touchDelegate = TouchDelegate(hitRect, this)
+      }
+    }
+  }
+
+  private fun getDrawableIdWithName(name: String): Int {
+    val appResources: Resources = context.resources
+    var resourceId = appResources.getIdentifier(name, "drawable", context.packageName)
+    if (resourceId == 0) {
+      // If drawable is not present in app's resources, check system's resources
+      resourceId = getResId(name, android.R.drawable::class.java)
+    }
+    return resourceId
+  }
+
+  private fun getResId(resName: String?, c: Class<*>): Int {
+    return try {
+      val idField: Field = c.getDeclaredField(resName!!)
+      idField.getInt(idField)
+    } catch (e: Exception) {
+      e.printStackTrace()
+      0
+    }
+  }
+
+  private fun getMenuItemTextWithColor(text: String, color: Int): SpannableStringBuilder {
+    val textWithColor = SpannableStringBuilder()
+    textWithColor.append(text)
+    textWithColor.setSpan(ForegroundColorSpan(color),
+      0, text.length, Spannable.SPAN_EXCLUSIVE_EXCLUSIVE)
+    return textWithColor
+  }
+
+  private fun resolveThemeColor(attribute: Int): Int? {
+    val typedValue = TypedValue()
+    if (!context.theme.resolveAttribute(attribute, typedValue, true)) {
+      return null
+    }
+    return when (typedValue.resourceId) {
+      0 -> typedValue.data
+      else -> context.getColor(typedValue.resourceId)
+    }
+  }
+
+  private fun resolveFrameworkPopupMenuHeaderColor(): Int? {
+    val typedValue = TypedValue()
+    if (!context.theme.resolveAttribute(
+        android.R.attr.textAppearancePopupMenuHeader,
+        typedValue,
+        true,
+      ) || typedValue.resourceId == 0) {
+      return resolveThemeColor(android.R.attr.textColorPrimary)
+    }
+    val textColors = TextAppearanceSpan(context, typedValue.resourceId).textColor
+      ?: return resolveThemeColor(android.R.attr.textColorPrimary)
+    return textColors.getColorForState(
+      intArrayOf(-android.R.attr.state_enabled),
+      textColors.defaultColor,
+    )
+  }
+}
