+        continue
+      }
+      val action = mActions.getMap(index) ?: continue
+      val isSelected = action.hasKey("state") &&
+        !action.isNull("state") &&
+        action.getString("state") == "on"
+      if (
+        isSelected &&
+        action.hasKey("selectedBackgroundColor") &&
+        !action.isNull("selectedBackgroundColor")
