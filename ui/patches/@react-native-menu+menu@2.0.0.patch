+  private var mObservedListView: ListView? = null
+  private var mPopupScrollChangedListener: ViewTreeObserver.OnScrollChangedListener? = null
+  private var mSelectedItemScrollApplied = false
+  private var mGestureDetector: GestureDetector
+  private var mHitSlopRect: Rect? = null
+    set(value) {
+      super.hitSlopRect = value
