{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // 与 Metro 一致，bun link 时也使用应用内已打补丁的 Navigation 类型。
      "@react-navigation/native-stack": ["./node_modules/@react-navigation/native-stack"],
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.config.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    ".expo",
    "android",
    "ios",
    "node_modules",
    "dist",
    "android",
    "rust/.build-cache",
    "rust/android",
    "rust/ios",
    "rust/crates",
    "rust/dist",
    "rust/target",
  ]
}
